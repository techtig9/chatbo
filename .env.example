# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API — console for your workspace
ANTHROPIC_API_KEY=

# Voyage AI embeddings
VOYAGE_API_KEY=

# Paddle Billing
# PADDLE_API_KEY / PADDLE_ENVIRONMENT are not yet consumed by any code path —
# every current Paddle interaction is either inbound webhooks (verified with
# PADDLE_WEBHOOK_SECRET) or client-side Paddle.js checkout (NEXT_PUBLIC_
# PADDLE_CLIENT_TOKEN). A server-side API key + environment are needed once
# the billing dashboard grows self-serve cancel/manage-subscription actions
# (Paddle customer portal / subscription API) instead of webhook-driven
# state sync alone.
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_STARTER=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_BUSINESS=

# Phase 1.10+ — Sentry error tracking
# Same DSN value for both — Sentry DSNs are safe to expose publicly (they
# only allow submitting events, not reading data), which is why the
# client one needs the NEXT_PUBLIC_ prefix: without it, Next.js won't
# embed the value in the browser bundle at all and client-side error
# capture silently does nothing.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional — enables source map upload on build (needs a
# SENTRY_AUTH_TOKEN too, generated from your Sentry account, not stored
# in this file). Without all three, next.config.mjs's withSentryConfig
# just skips source map upload rather than failing the build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Phase 1.14 — Resend transactional email
RESEND_API_KEY=
# Optional — defaults to "chatbo.ai <notifications@chatbo.ai>" if unset.
# Must be a verified sending domain/address in your Resend account.
RESEND_FROM_EMAIL=

# Phase 1.13/1.18 — Upstash Redis (rate limiting, response cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Phase 1.13/1.20 — Inngest background jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Phase 1.20 — set after running the concierge bot seed action once
# (Admin panel → System). Not needed for the app to build or run —
# only for the "Ask chatbo" dashboard launcher and marketing-site widget
# to actually appear, and for the scheduled Inngest re-ingestion job to
# know which bot to refresh.
CONCIERGE_BOT_ID=

# Phase 1.13 — outbound webhook payload signing
WEBHOOK_SIGNING_SECRET=

# Phase 1.19 — weekly backup export storage (S3-compatible: AWS S3,
# Cloudflare R2, Backblaze B2, etc.). Omit BACKUP_S3_ENDPOINT for real
# AWS S3; set it for any other S3-compatible provider.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=

# AI Gateway. Automatic chat/completion routing uses Groq -> Cerebras -> OpenRouter; Claude is reserved for complex/difficult tasks.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
APP_URL=http://localhost:3000
# Optional USD cost metadata per 1M tokens. Keep 0 until you configure current provider pricing.
AI_COST_GEMINI_INPUT_PER_1M=0
AI_COST_GEMINI_OUTPUT_PER_1M=0
AI_COST_GEMINI_CACHED_PER_1M=0
AI_COST_GROQ_INPUT_PER_1M=0
AI_COST_GROQ_OUTPUT_PER_1M=0
AI_COST_GROQ_CACHED_PER_1M=0
AI_COST_CEREBRAS_INPUT_PER_1M=0
AI_COST_CEREBRAS_OUTPUT_PER_1M=0
AI_COST_CEREBRAS_CACHED_PER_1M=0
AI_COST_OPENROUTER_INPUT_PER_1M=0
AI_COST_OPENROUTER_OUTPUT_PER_1M=0
AI_COST_OPENROUTER_CACHED_PER_1M=0
AI_COST_ANTHROPIC_INPUT_PER_1M=0
AI_COST_ANTHROPIC_OUTPUT_PER_1M=0
AI_COST_ANTHROPIC_CACHED_PER_1M=0

# Phase 13/27 — OAuth integrations and encryption. TOOL_SECRET_KEY is the
# general-purpose encryption key (lib/tools/integration-config.ts) used for
# every stored integration/channel secret — this is the app's ENCRYPTION_KEY,
# just under its original Phase-13 name; there is no separate key. Configure
# only the OAuth client credentials for the providers you actually enable.
TOOL_SECRET_KEY=base64-encoded-32-byte-secret
CHANNEL_OAUTH_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ============================================================
# Chatbo AI Provider Failover Policy
# ============================================================
# Automatic routing:
#   Simple/Normal: Groq -> Cerebras -> OpenRouter
#   Complex:       Groq -> Cerebras -> OpenRouter -> Claude
#
# A provider is skipped when its key is missing. If a provider returns a
# quota/rate-limit error (normally HTTP 429), or another provider failure,
# Chatbo automatically fails over to the next configured provider.
# Claude/Anthropic is intentionally available only as the final provider for
# tasks classified as complex/difficult by the AI gateway.
AI_ROUTING_POLICY=groq,cerebras,openrouter,anthropic-complex-only
AI_ENABLE_CLAUDE_COMPLEX_ONLY=true
